{
  "manifest_version": 2,
  "name": "S&F Advisor",
  "version": "1.0",
  "description": "Helps you fill the scrapbook in Shakes and Fidget by showing you the players with the most items, that you have not found yet",
  "permissions": [
    "storage",
    "webRequest",
    "*://sfgame.net/*",
    "*://*.sfgame.net/*",
    "https://mfbot-api.marenga.dev/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "S&F Advisor"
  },
  "content_scripts": [
    {
      "matches": ["*://sfgame.net/*", "*://*.sfgame.net/*"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "injected_page_hook.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@sf-advisor.marenga"
    }
  }
}
